PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# bcrypt cost factorse
PASSWORD_SALT_ROUNDS=number_of_rounds
PIN_SALT_ROUNDS=number_of_rounds

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:PORT

# Rate limiting
RATE_LIMIT_WINDOW_MS=hundreds_thousands_of_milliseconds
RATE_LIMIT_MAX=less_than_1000
AUTH_RATE_LIMIT_MAX=less_than_100
